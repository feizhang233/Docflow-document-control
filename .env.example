MYSQL_DATABASE=docflow
MYSQL_USER=docflow
MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_password
CORS_ORIGINS=https://documents.example.com
SEED_DEMO_DATA=true
EXTERNAL_API_KEY=replace_with_a_long_random_api_key
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_ACCESS_MINUTES=30
# Absolute sign-in lifetime; refreshing does not extend it.
AUTH_SESSION_HOURS=24

# Outgoing mail: subscriptions are saved but no emails are sent until configured.
# See EMAIL_SETUP.md. Update the deployed .env, then recreate the backend container.
# One sending account serves all projects; personal notification emails are recipients.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# starttls (587), ssl (465), or plain for a trusted local mail relay.
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15
EMAIL_POLL_SECONDS=30
PUBLIC_APP_URL=https://documents.example.com
